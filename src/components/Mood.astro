---
/** АТМОСФЕРА — тёмный wash. Цветущая ветка: стебли прочерчиваются,
 *  следом проступают листья и соцветия — под текст «зелень и цветы». */
---

<section
  class="mood relative overflow-hidden py-[var(--sy)] text-cream-0"
  id="mood"
  aria-labelledby="mood-h"
>
  <svg class="botanical botanical--mood" aria-hidden="true"><use href="#sprig-grass" /></svg>
  <div class="shell reveal">
    <h2 class="head text-cream-0" id="mood-h">атмосфера&nbsp;вечера</h2>
    <p class="m-0 mb-md max-w-[34ch] text-xl leading-normal text-cream-1 text-pretty">
      Нас ждёт зал под&nbsp;белым шёлковым небом: изумрудный бархат, молочные акценты, зелень и&nbsp;цветы.
    </p>
    <p class="m-0 max-w-[34ch] text-xl leading-normal text-milk italic text-pretty">
      Всё так, как мы&nbsp;любим&nbsp;— природно, светло и&nbsp;по-настоящему тепло.
    </p>
    <svg
      class="bloom absolute right-0 bottom-[-12%] h-auto w-[clamp(200px,26vw,330px)] max-lg:static max-lg:mx-auto max-lg:mt-lg max-lg:mb-0 max-lg:w-[min(240px,64vw)]"
      viewBox="0 0 260 210"
      fill="none"
      aria-hidden="true"
    >
      <path class="bloom__stem" pathLength="1" d="M64 198 C 74 150, 92 112, 132 74 C 150 56, 166 44, 178 36"></path>
      <path class="bloom__stem" pathLength="1" d="M66 198 C 62 156, 66 122, 78 86 C 84 66, 92 52, 98 42"></path>
      <path class="bloom__stem" pathLength="1" d="M66 197 C 84 162, 116 140, 158 126 C 186 116, 212 112, 232 110"></path>
      <g class="bloom__leaf">
        <ellipse cx="84" cy="150" rx="10" ry="7.5" transform="rotate(-34 84 150)"/>
        <ellipse cx="100" cy="122" rx="10.5" ry="8" transform="rotate(-30 100 122)"/>
        <ellipse cx="120" cy="96" rx="10" ry="7.5" transform="rotate(-26 120 96)"/>
        <ellipse cx="140" cy="72" rx="9" ry="7" transform="rotate(-22 140 72)"/>
        <ellipse cx="158" cy="54" rx="8" ry="6" transform="rotate(-20 158 54)"/>
        <ellipse cx="70" cy="158" rx="9" ry="7" transform="rotate(22 70 158)"/>
        <ellipse cx="74" cy="128" rx="9.5" ry="7" transform="rotate(18 74 128)"/>
        <ellipse cx="82" cy="100" rx="9" ry="6.5" transform="rotate(14 82 100)"/>
        <ellipse cx="90" cy="74" rx="8" ry="6" transform="rotate(12 90 74)"/>
        <ellipse cx="96" cy="168" rx="9.5" ry="7" transform="rotate(16 96 168)"/>
        <ellipse cx="124" cy="150" rx="10" ry="7.5" transform="rotate(10 124 150)"/>
        <ellipse cx="154" cy="136" rx="9.5" ry="7" transform="rotate(6 154 136)"/>
        <ellipse cx="184" cy="126" rx="8.5" ry="6.5" transform="rotate(4 184 126)"/>
        <ellipse cx="210" cy="118" rx="7.5" ry="5.5" transform="rotate(2 210 118)"/>
      </g>
      <g class="bloom__flower">
        <g><circle cx="178.0" cy="30.8" r="3.4"/><circle cx="183.0" cy="34.4" r="3.4"/><circle cx="181.1" cy="40.2" r="3.4"/><circle cx="174.9" cy="40.2" r="3.4"/><circle cx="173.0" cy="34.4" r="3.4"/><circle class="bloom__heart" cx="178" cy="36" r="2.5"/></g>
        <g><circle cx="98.0" cy="37.2" r="3.1"/><circle cx="102.5" cy="40.5" r="3.1"/><circle cx="100.8" cy="45.8" r="3.1"/><circle cx="95.2" cy="45.8" r="3.1"/><circle cx="93.5" cy="40.5" r="3.1"/><circle class="bloom__heart" cx="98" cy="42" r="2.2"/></g>
        <g><circle cx="232.0" cy="105.7" r="2.8"/><circle cx="236.1" cy="108.7" r="2.8"/><circle cx="234.5" cy="113.5" r="2.8"/><circle cx="229.5" cy="113.5" r="2.8"/><circle cx="227.9" cy="108.7" r="2.8"/><circle class="bloom__heart" cx="232" cy="110" r="2.0"/></g>
        <g><circle cx="150.0" cy="58.6" r="2.2"/><circle cx="153.3" cy="60.9" r="2.2"/><circle cx="152.0" cy="64.8" r="2.2"/><circle cx="148.0" cy="64.8" r="2.2"/><circle cx="146.7" cy="60.9" r="2.2"/><circle class="bloom__heart" cx="150" cy="62" r="1.6"/></g>
        <g><circle cx="86.0" cy="59.0" r="2.0"/><circle cx="88.9" cy="61.1" r="2.0"/><circle cx="87.8" cy="64.5" r="2.0"/><circle cx="84.2" cy="64.5" r="2.0"/><circle cx="83.1" cy="61.1" r="2.0"/><circle class="bloom__heart" cx="86" cy="62" r="1.4"/></g>
        <g><circle cx="200.0" cy="112.8" r="2.1"/><circle cx="203.1" cy="115.0" r="2.1"/><circle cx="201.9" cy="118.6" r="2.1"/><circle cx="198.1" cy="118.6" r="2.1"/><circle cx="196.9" cy="115.0" r="2.1"/><circle class="bloom__heart" cx="200" cy="116" r="1.5"/></g>
      </g>
    </svg>
  </div>
</section>
